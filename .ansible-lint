---
# ansible-lint configuration for startechnica.infra
# https://ansible.readthedocs.io/projects/lint/configuring/

profile: production

exclude_paths:
  - .cache/
  - .github/
  - playbooks/artifacts/
  - artifacts/
  # Vendored standalone role reinstalled by `ansible-galaxy role install`
  # in CI — not our code to lint.
  - roles/geerlingguy.docker/

skip_list:
  # Allow inline Jinja that looks like flow maps (our JS-in-mongosh eval).
  - yaml[braces]
  # Permit risky-shell on specific tasks where we've intentionally inlined
  # shell commands with pipes/redirection.
  - risky-shell-pipe
  # Playbook names already used consistently, no need for metadata.
  - meta-no-info
  # Allow plain-text passwords in defaults/inventories (per project policy).
  - no-log-password
  # Roles use a leading-underscore convention for internal register/set_fact
  # vars (e.g. _deploy_jobs, _vm_probe). The role-prefix sub-rule would
  # require renaming dozens of internal vars across every role for no
  # behavioral gain; keep the convention and skip the sub-rule. Other
  # var-naming checks (illegal chars, reserved names) still apply.
  - var-naming[no-role-prefix]

warn_list:
  - experimental
  - jinja[spacing]

kinds:
  # Underscore-prefixed files in playbooks/ are tasks-only fragments
  # (e.g. _setup.yml) consumed by sibling playbooks via include_tasks —
  # must be classified before the playbook glob below.
  - tasks: "playbooks/**/_*.yml"
  - playbook: "playbooks/**/*.yml"
  - tasks: "roles/*/tasks/**/*.yml"
  - vars: "roles/*/defaults/**/*.yml"
  - vars: "roles/*/vars/**/*.yml"
  - handlers: "roles/*/handlers/**/*.yml"
  - meta: "roles/*/meta/**/*.yml"
