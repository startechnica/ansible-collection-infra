{# ────────────────────────────────────────────────────────────────────────
 # STARTER TEMPLATE — Red Hat CoreOS
 #
 # CAVEAT: Production OpenShift clusters bootstrap RHCOS via the
 # `openshift-install` tool which generates its own Ignition with
 # MachineConfig overlays from the cluster's OpenShift API. Rolling your
 # own Butane outside that flow is unusual and is typically only useful
 # for single-node sandbox / day-2 customisation that openshift-install
 # doesn't already cover.
 #
 # Functional baseline: variant header (openshift), default user,
 # hostname, NetworkManager keyfile. NOT yet covered:
 #   - MachineConfig integration
 #   - openshift-install ignition merging
 #   - cluster pull-secret / pulled images
 #
 # Test against your RHCOS image before relying on this. Consult the
 # openshift docs for the spec version that matches your cluster's OCP
 # minor (4.16+ typically uses openshift 4.16.0 spec).
 # ─────────────────────────────────────────────────────────────────────── #}
variant: {{ _platform_preset.ignition.butane_variant }}
version: {{ _platform_preset.ignition.butane_spec_version }}

passwd:
  users:
    - name: {{ instance_user_name | default('core') }}
{% if instance_user_password | default('') | length > 0 %}
      password_hash: {{ instance_user_password | password_hash('sha512') }}
{% endif %}
{% if instance_user_ssh_authorized_keys | default([]) | length > 0 %}
      ssh_authorized_keys:
{% for k in instance_user_ssh_authorized_keys %}
        - {{ k }}
{% endfor %}
{% endif %}

storage:
  files:
    - path: /etc/hostname
      mode: 0644
      contents:
        inline: {{ instance.hostname }}{{ '.' ~ instance_domain_name if instance_domain_name | default('') | length > 0 else '' }}
{% set _eff_ssh_port = (instance.ssh_port | default(instance_ssh_port | default(22))) | int %}
{% if _eff_ssh_port != 22 %}

    # sshd port fast-path: written at first boot so sshd binds {{ _eff_ssh_port }}
    # directly. Filename matches post-boot ssh_config.yml so its probe skips
    # the migration phase. See roles/instance/tasks/ssh_config.yml.
    # SELinux port label is set by the post-boot task's preflight (semanage
    # isn't available in initramfs; first sshd start may emit SELinux warnings
    # on the new port until preflight runs — harmless, sshd still binds).
    - path: /etc/ssh/sshd_config.d/99-ansible.conf
      mode: 0644
      contents:
        inline: |
          # Managed by startechnica.infra.instance_ignition (Butane fast-path)
          Port {{ _eff_ssh_port }}
{% endif %}

    # NetworkManager keyfiles, one per NIC. RHCOS uses NetworkManager.
    # Keyfiles MUST be mode 0600 or NM refuses to load. Default route +
    # DNS land on the first NIC only.
{% for nic in (instance.networks | default([])) %}
{%   set _eff = (instance_networks | default({})) | combine(nic) %}
{%   set _ifname = _eff.device | default('ens' ~ (192 + loop.index0 * 32) | string) %}
{%   set _static4 = _eff.ipv4 is defined and _eff.ipv4 != 'dhcp' %}
{%   set _static6 = _eff.ipv6 is defined and _eff.ipv6 != 'dhcp6' %}
{%   set _addr4_cidr = _eff.ipv4 if (_static4 and '/' in (_eff.ipv4 | string)) else (_eff.ipv4 | default('') ~ '/24') %}
{%   set _addr6_cidr = _eff.ipv6 if (_static6 and '/' in (_eff.ipv6 | string)) else (_eff.ipv6 | default('') ~ '/64') %}
    - path: /etc/NetworkManager/system-connections/{{ _ifname }}.nmconnection
      mode: 0600
      contents:
        inline: |
          [connection]
          id={{ _ifname }}
          type=ethernet
          interface-name={{ _ifname }}
          autoconnect=true

{%   if _eff.mtu is defined %}
          [ethernet]
          mtu={{ _eff.mtu | int }}

{%   endif %}
          [ipv4]
{%   if _static4 %}
          method=manual
          address1={{ _addr4_cidr }}{{ ',' ~ _eff.gateway4 if (loop.first and _eff.gateway4 is defined) else '' }}
{%     if loop.first and (instance_dns_servers | default([]) | length > 0) %}
          dns={{ instance_dns_servers | join(';') }};
{%     endif %}
{%   elif (_eff.ipv4 | default('')) == 'dhcp' %}
          method=auto
{%   else %}
          method=disabled
{%   endif %}

          [ipv6]
{%   if _static6 %}
          method=manual
          address1={{ _addr6_cidr }}{{ ',' ~ _eff.gateway6 if (loop.first and _eff.gateway6 is defined) else '' }}
{%   elif (_eff.ipv6 | default('')) == 'dhcp6' %}
          method=auto
{%   else %}
          method=ignore
{%   endif %}
{% endfor %}
