# Auto-generated by the startechnica.infra.grafana_alloy role.
services:
  alloy:
    image: {{ grafana_alloy_image }}
    container_name: grafana-alloy
    restart: unless-stopped
    # Entrypoint is /bin/alloy; this is the `run` subcommand + flags.
    command:
      - run
      - /etc/alloy/config.alloy
      - --storage.path=/var/lib/alloy/data
      - --server.http.listen-addr={{ grafana_alloy_listen_address }}:{{ grafana_alloy_listen_port }}
    network_mode: {{ grafana_alloy_network_mode }}
{% if grafana_alloy_host_metrics_module_active | bool %}
    # The host_metrics module requires the host PID namespace.
    pid: host
{% endif %}
{% if grafana_alloy_env_has_secrets | bool %}
    env_file:
      - {{ grafana_alloy_env_file }}
{% endif %}
    volumes:
      - {{ grafana_alloy_config_file }}:/etc/alloy/config.alloy:ro,Z
      - {{ grafana_alloy_data_dir }}:/var/lib/alloy/data:Z
      # Host telemetry sources (read-only). journald for logs; proc/sys/rootfs
      # for the unix exporter (paths overridden in config.alloy to /host/*).
      - /var/log/journal:/var/log/journal:ro,z
      - /run/log/journal:/run/log/journal:ro,z
      - /etc/machine-id:/etc/machine-id:ro
      - /proc:/host/proc:ro
      - /sys:/host/sys:ro
{% if grafana_alloy_host_metrics_module_active | bool %}
      # host_metrics module: host / at /host/root; rslave so the host's /run
      # tmpfs (udev data for diskstats) is visible beneath it.
      - /:/host/root:ro,rslave
{% if grafana_alloy_module_password_file_active | bool %}
      # The module's Prometheus password, read by local.file as a secret.
      - {{ grafana_alloy_secrets_dir }}:/etc/alloy/secrets:ro,Z
{% endif %}
{% else %}
      - /:/rootfs:ro
{% endif %}
    deploy:
      resources:
        limits:
          memory: {{ grafana_alloy_mem_limit_mb }}m
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
