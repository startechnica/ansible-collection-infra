{#- Assemble the chosen trace exporter's input reference up front. -#}
{%- set _trace_exporter_input = 'otelcol.exporter.otlphttp.default.input' if grafana_alloy_tempo_protocol == 'http' else 'otelcol.exporter.otlp.default.input' -%}
{#- Metrics sink: the host_metrics module's remote_write when the module is active, else the role's own. -#}
{%- set _module = grafana_alloy_host_metrics_module_active | bool -%}
{%- set _metrics_sink = 'host_metrics.unix.node.receiver' if _module else 'prometheus.remote_write.default.receiver' -%}
{#- The module's external_labels REPLACE its region/zone/cluster_name defaults, so pass the full set. -#}
{%- set _module_labels = grafana_alloy_external_labels | combine({'cluster': grafana_alloy_cluster_label} if grafana_alloy_cluster_label | length > 0 else {}) -%}
{#- Alloy string literal: escape backslashes and double quotes. -#}
{%- macro q(v) -%}"{{ v | string | replace('\\', '\\\\') | replace('"', '\\"') }}"{%- endmacro -%}
// Auto-generated by the startechnica.infra.grafana_alloy role. DO NOT EDIT.
// Backend credentials are NOT stored here — they live in alloy.env (0600)
// and are read at runtime with sys.env(). Re-render via the Ansible role.

logging {
  level  = "{{ grafana_alloy_log_level }}"
  format = "logfmt"
}
{% if grafana_alloy_logs_enabled | bool %}

// ─────────────────────────────── Logs → Loki ───────────────────────────────
loki.write "default" {
  endpoint {
    url = "{{ grafana_alloy_loki_url }}"
{% if grafana_alloy_loki_username | length > 0 %}
    basic_auth {
      username = "{{ grafana_alloy_loki_username }}"
      password = sys.env("ALLOY_LOKI_PASSWORD")
    }
{% endif %}
{% if grafana_alloy_loki_tenant_id | length > 0 %}
    tenant_id = "{{ grafana_alloy_loki_tenant_id }}"
{% endif %}
  }
{% if grafana_alloy_external_labels | length > 0 %}

  external_labels = {
{% for _k, _v in grafana_alloy_external_labels | dictsort %}
    {{ _k }} = {{ q(_v) }},
{% endfor %}
  }
{% endif %}
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  max_age       = "{{ grafana_alloy_journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]

  labels = {
    job  = "systemd-journal",
    host = constants.hostname,
{% if grafana_alloy_cluster_label | length > 0 %}
    cluster = "{{ grafana_alloy_cluster_label }}",
{% endif %}
  }
}
{% endif %}
{% if grafana_alloy_metrics_enabled | bool %}
{% if _module %}

// ─────────── Metrics → Prometheus (startechnica/grafana host_metrics) ───────
// Host metrics come from the host_metrics.unix module: job "integrations/unix",
// instance and node set to this host's name — the same shape as Kubernetes
// nodes running the module. The module owns the remote_write (tenant header,
// basic auth, external labels); the extra scrapes below forward into it
// through its exported receiver. It reads the host through the /host/root,
// /host/proc and /host/sys mounts (see the compose file / Quadlet).
import.git "host_metrics" {
  repository     = {{ q(grafana_alloy_host_metrics_module_repository) }}
  revision       = {{ q(grafana_alloy_host_metrics_module_revision) }}
  path           = {{ q(grafana_alloy_host_metrics_module_path) }}
  pull_frequency = {{ q(grafana_alloy_host_metrics_module_pull_frequency) }}
}

host_metrics.unix "node" {
  tenant_id                    = {{ q(grafana_alloy_prometheus_tenant_id) }}
  endpoint_url                 = {{ q(grafana_alloy_prometheus_url) }}
  endpoint_basic_auth_username = {{ q(grafana_alloy_prometheus_username) }}
  endpoint_basic_auth_password = sys.env("ALLOY_PROMETHEUS_PASSWORD")
{% if _module_labels | length > 0 %}

  // The complete external label set: replaces the module's region / zone /
  // cluster_name defaults, so a label not listed here is not sent at all.
  external_labels = {
{% for _k, _v in _module_labels | dictsort %}
    {{ _k }} = {{ q(_v) }},
{% endfor %}
  }
{% endif %}
}
{% else %}

// ──────────────────────────── Metrics → Prometheus ─────────────────────────
prometheus.remote_write "default" {
  endpoint {
    url = "{{ grafana_alloy_prometheus_url }}"
{% if grafana_alloy_prometheus_username | length > 0 %}
    basic_auth {
      username = "{{ grafana_alloy_prometheus_username }}"
      password = sys.env("ALLOY_PROMETHEUS_PASSWORD")
    }
{% endif %}
{% if grafana_alloy_prometheus_tenant_id | length > 0 %}

    headers = {
      "X-Scope-OrgID" = {{ q(grafana_alloy_prometheus_tenant_id) }},
    }
{% endif %}
  }

  external_labels = {
    host = constants.hostname,
{% if grafana_alloy_cluster_label | length > 0 %}
    cluster = "{{ grafana_alloy_cluster_label }}",
{% endif %}
{% for _k, _v in grafana_alloy_external_labels | dictsort %}
    {{ _k }} = {{ q(_v) }},
{% endfor %}
  }
}
{% if grafana_alloy_node_exporter_enabled | bool %}

// Host node metrics. procfs/sysfs/rootfs point at the host paths bind-mounted
// into the container (see the compose/Quadlet volumes), so metrics reflect the
// host and not the container.
prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "{{ grafana_alloy_scrape_interval }}"
  job_name        = "integrations/node_exporter"
}
{% endif %}
{% endif %}
{% for _s in grafana_alloy_scrapes %}
{% set _name = (_s.name | default(_s.job)) | regex_replace('[^A-Za-z0-9_]', '_') %}
{% set _drop = _s.metric_drop_regex | default('') | length > 0 %}

// Extra scrape: {{ _s.job }}
// instance = this host's name, not the scrape address, so these series join
// the host metrics on instance.
prometheus.scrape "{{ _name }}" {
  targets = [
{% for _t in _s.targets %}
    {
      "__address__" = {{ q(_t) }},
      "instance"    = constants.hostname,
{% for _k, _v in (_s.labels | default({})) | dictsort %}
      {{ q(_k) }} = {{ q(_v) }},
{% endfor %}
    },
{% endfor %}
  ]
  forward_to      = [{{ ('prometheus.relabel.' ~ _name ~ '.receiver') if _drop else _metrics_sink }}]
  job_name        = {{ q(_s.job) }}
  scrape_interval = {{ q(_s.scrape_interval | default(grafana_alloy_scrape_interval)) }}
  scheme          = {{ q(_s.scheme | default('http')) }}
  metrics_path    = {{ q(_s.metrics_path | default('/metrics')) }}
{% if _s.tls_insecure_skip_verify | default(false) | bool %}

  tls_config {
    insecure_skip_verify = true
  }
{% endif %}
}
{% if _drop %}

prometheus.relabel "{{ _name }}" {
  forward_to = [{{ _metrics_sink }}]

  rule {
    source_labels = ["__name__"]
    regex         = {{ q(_s.metric_drop_regex) }}
    action        = "drop"
  }
}
{% endif %}
{% endfor %}
{% endif %}
{% if grafana_alloy_traces_enabled | bool %}

// ─────────────────────────────── Traces → Tempo ────────────────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "{{ grafana_alloy_listen_address }}:{{ grafana_alloy_otlp_grpc_port }}"
  }

  http {
    endpoint = "{{ grafana_alloy_listen_address }}:{{ grafana_alloy_otlp_http_port }}"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [{{ _trace_exporter_input }}]
  }
}
{% if grafana_alloy_tempo_username | length > 0 %}

otelcol.auth.basic "tempo" {
  username = "{{ grafana_alloy_tempo_username }}"
  password = sys.env("ALLOY_TEMPO_PASSWORD")
}
{% endif %}
{% if grafana_alloy_tempo_protocol == 'http' %}

otelcol.exporter.otlphttp "default" {
  client {
    endpoint = "{{ grafana_alloy_tempo_url }}"
{% if grafana_alloy_tempo_username | length > 0 %}
    auth = otelcol.auth.basic.tempo.handler
{% endif %}
  }
}
{% else %}

otelcol.exporter.otlp "default" {
  client {
    endpoint = "{{ grafana_alloy_tempo_url }}"
{% if grafana_alloy_tempo_username | length > 0 %}
    auth = otelcol.auth.basic.tempo.handler
{% else %}
    tls {
      insecure = true
    }
{% endif %}
  }
}
{% endif %}
{% endif %}
