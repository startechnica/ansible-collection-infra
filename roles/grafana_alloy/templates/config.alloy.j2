{#- Assemble the chosen trace exporter's input reference up front. -#}
{%- set _trace_exporter_input = 'otelcol.exporter.otlphttp.default.input' if grafana_alloy_tempo_protocol == 'http' else 'otelcol.exporter.otlp.default.input' -%}
// Auto-generated by the startechnica.infra.grafana_alloy role. DO NOT EDIT.
// Backend credentials are NOT stored here — they live in alloy.env (0600)
// and are read at runtime with sys.env(). Re-render via the Ansible role.

logging {
  level  = "{{ grafana_alloy_log_level }}"
  format = "logfmt"
}
{% if grafana_alloy_logs_enabled | bool %}

// ─────────────────────────────── Logs → Loki ───────────────────────────────
loki.write "default" {
  endpoint {
    url = "{{ grafana_alloy_loki_url }}"
{% if grafana_alloy_loki_username | length > 0 %}
    basic_auth {
      username = "{{ grafana_alloy_loki_username }}"
      password = sys.env("ALLOY_LOKI_PASSWORD")
    }
{% endif %}
{% if grafana_alloy_loki_tenant_id | length > 0 %}
    tenant_id = "{{ grafana_alloy_loki_tenant_id }}"
{% endif %}
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }
  rule {
    source_labels = ["__journal_priority_keyword"]
    target_label  = "level"
  }
}

loki.source.journal "host" {
  max_age       = "{{ grafana_alloy_journal_max_age }}"
  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.default.receiver]

  labels = {
    job  = "systemd-journal",
    host = constants.hostname,
{% if grafana_alloy_cluster_label | length > 0 %}
    cluster = "{{ grafana_alloy_cluster_label }}",
{% endif %}
  }
}
{% endif %}
{% if grafana_alloy_metrics_enabled | bool %}

// ──────────────────────────── Metrics → Prometheus ─────────────────────────
prometheus.remote_write "default" {
  endpoint {
    url = "{{ grafana_alloy_prometheus_url }}"
{% if grafana_alloy_prometheus_username | length > 0 %}
    basic_auth {
      username = "{{ grafana_alloy_prometheus_username }}"
      password = sys.env("ALLOY_PROMETHEUS_PASSWORD")
    }
{% endif %}
  }

  external_labels = {
    host = constants.hostname,
{% if grafana_alloy_cluster_label | length > 0 %}
    cluster = "{{ grafana_alloy_cluster_label }}",
{% endif %}
  }
}
{% if grafana_alloy_node_exporter_enabled | bool %}

// Host node metrics. procfs/sysfs/rootfs point at the host paths bind-mounted
// into the container (see the compose/Quadlet volumes), so metrics reflect the
// host and not the container.
prometheus.exporter.unix "node" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
}

prometheus.scrape "node" {
  targets         = prometheus.exporter.unix.node.targets
  forward_to      = [prometheus.remote_write.default.receiver]
  scrape_interval = "{{ grafana_alloy_scrape_interval }}"
  job_name        = "integrations/node_exporter"
}
{% endif %}
{% endif %}
{% if grafana_alloy_traces_enabled | bool %}

// ─────────────────────────────── Traces → Tempo ────────────────────────────
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "{{ grafana_alloy_listen_address }}:{{ grafana_alloy_otlp_grpc_port }}"
  }

  http {
    endpoint = "{{ grafana_alloy_listen_address }}:{{ grafana_alloy_otlp_http_port }}"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  output {
    traces = [{{ _trace_exporter_input }}]
  }
}
{% if grafana_alloy_tempo_username | length > 0 %}

otelcol.auth.basic "tempo" {
  username = "{{ grafana_alloy_tempo_username }}"
  password = sys.env("ALLOY_TEMPO_PASSWORD")
}
{% endif %}
{% if grafana_alloy_tempo_protocol == 'http' %}

otelcol.exporter.otlphttp "default" {
  client {
    endpoint = "{{ grafana_alloy_tempo_url }}"
{% if grafana_alloy_tempo_username | length > 0 %}
    auth = otelcol.auth.basic.tempo.handler
{% endif %}
  }
}
{% else %}

otelcol.exporter.otlp "default" {
  client {
    endpoint = "{{ grafana_alloy_tempo_url }}"
{% if grafana_alloy_tempo_username | length > 0 %}
    auth = otelcol.auth.basic.tempo.handler
{% else %}
    tls {
      insecure = true
    }
{% endif %}
  }
}
{% endif %}
{% endif %}
