{# Backend credentials, referenced from config.alloy via sys.env(). #}
{# Rendered only when at least one *_password is set; mode 0600, root-only. #}
{% if grafana_alloy_loki_password | length > 0 %}
ALLOY_LOKI_PASSWORD={{ grafana_alloy_loki_password }}
{% endif %}
{% if grafana_alloy_prometheus_password | length > 0 %}
ALLOY_PROMETHEUS_PASSWORD={{ grafana_alloy_prometheus_password }}
{% endif %}
{% if grafana_alloy_tempo_password | length > 0 %}
ALLOY_TEMPO_PASSWORD={{ grafana_alloy_tempo_password }}
{% endif %}
