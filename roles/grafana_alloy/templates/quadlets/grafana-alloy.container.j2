# Auto-generated by the startechnica.infra.grafana_alloy role (Quadlet path).
[Unit]
Description=Grafana Alloy telemetry collector
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=grafana-alloy
Image={{ grafana_alloy_image }}
Network=host
{% if grafana_alloy_env_has_secrets | bool %}
EnvironmentFile={{ grafana_alloy_env_file }}
{% endif %}
# Entrypoint is /bin/alloy; Exec is the `run` subcommand + flags.
Exec=run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data --server.http.listen-addr={{ grafana_alloy_listen_address }}:{{ grafana_alloy_listen_port }}

Volume={{ grafana_alloy_config_file }}:/etc/alloy/config.alloy:ro,Z
Volume={{ grafana_alloy_data_dir }}:/var/lib/alloy/data:Z
# Host telemetry sources (read-only). journald for logs; proc/sys/rootfs for
# the unix exporter (paths overridden in config.alloy to /host/*).
Volume=/var/log/journal:/var/log/journal:ro,z
Volume=/run/log/journal:/run/log/journal:ro,z
Volume=/etc/machine-id:/etc/machine-id:ro
Volume=/proc:/host/proc:ro
Volume=/sys:/host/sys:ro
{% if grafana_alloy_host_metrics_module_active | bool %}
# host_metrics module: host / at /host/root. rslave so the host's /run tmpfs
# (udev data for the diskstats collector) is visible beneath it. Never add z/Z
# here: that would relabel the whole host filesystem.
Volume=/:/host/root:ro,rslave
{% if grafana_alloy_module_password_file_active | bool %}
# The module's Prometheus password, read by local.file as a secret.
Volume={{ grafana_alloy_secrets_dir }}:/etc/alloy/secrets:ro,Z
{% endif %}
# The module requires the host PID namespace alongside host networking.
PodmanArgs=--pid=host
{% else %}
Volume=/:/rootfs:ro
{% endif %}

Memory={{ grafana_alloy_mem_limit_mb }}m
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
