# Auto-generated by Ansible patroni role (Quadlet path).
# PgBouncer connection pooler in front of patroni's PostgreSQL.
[Unit]
Description=PgBouncer (PostgreSQL connection pooler)
Wants=network-online.target patroni.service
After=network-online.target patroni.service
Requires=patroni.service

[Container]
ContainerName=pgbouncer
Image={{ pgbouncer_image }}
User={{ pgbouncer_uid }}
Group={{ pgbouncer_gid }}
Network=host

Volume={{ pgbouncer_dir }}/pgbouncer.ini:/etc/pgbouncer/pgbouncer.ini:ro,Z
Volume={{ pgbouncer_dir }}/userlist.txt:/etc/pgbouncer/userlist.txt:ro,Z
Volume={{ pgbouncer_certs_dir }}:/etc/certs:ro,Z

PodmanArgs=--ulimit nofile=65536:65536

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
