# Auto-generated by Ansible patroni role (Quadlet path).
# Prometheus exporter for PostgreSQL metrics. Connects to patroni's
# PostgreSQL via host loopback (`Network=host`).
[Unit]
Description=postgres_exporter (Prometheus metrics)
Wants=network-online.target patroni.service
After=network-online.target patroni.service
Requires=patroni.service

[Container]
ContainerName=postgres-exporter
Image={{ patroni_postgres_exporter_image }}
Network=host

# `$$external` is the literal-`$` escape if anyone needs it later — we
# don't here, but mirroring mongodb's pattern for consistency.
Environment=DATA_SOURCE_NAME=postgresql://postgres:{{ patroni_postgresql_postgres_password }}@127.0.0.1:{{ patroni_postgresql_port }}/postgres?sslmode=disable

Memory={{ patroni_postgres_exporter_mem_limit_mb }}m
# First in line for the OOM killer — telemetry, nothing depends on it.
PodmanArgs=--oom-score-adj={{ patroni_postgres_exporter_oom_score_adj }}
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
