# Auto-generated by Ansible patroni role (Quadlet path).
# Patroni-managed PostgreSQL. Network=host so streaming replication
# peers identify each other by host:port (matching docker-compose
# semantics, no NAT in the path).
[Unit]
Description=Patroni-managed PostgreSQL
Wants=network-online.target etcd.service
After=network-online.target etcd.service
{% if walg_enabled %}
Requires=walg-init.service
After=walg-init.service
{% endif %}
Requires=etcd.service

[Container]
ContainerName=patroni
Image={{ patroni_image }}
User={{ patroni_uid }}
Group={{ patroni_gid }}
Network=host

Environment=PATRONI_CONFIG=/etc/patroni/patroni.yml
Environment=PATRONI_POSTGRESQL_DATA_DIR=/var/lib/postgresql/pg_data
Environment=PATRONI_POSTGRESQL_CONFIG_DIR=/var/lib/postgresql/pg_data
{% if walg_enabled %}
EnvironmentFile={{ walg_dir }}/walg.env
{% endif %}

Volume={{ postgresql_root_dir }}:/var/lib/postgresql:Z
Volume={{ postgresql_log_dir }}:/var/log/postgresql:Z
Volume={{ patroni_certs_dir }}:/etc/certs:ro,Z
Volume={{ patroni_dir }}/patroni.yml:/etc/patroni/patroni.yml:ro,Z
Volume={{ wal_archive_dir }}:/wal_archive:Z
Volume={{ patroni_backup_dir }}:/var/lib/postgresql/backups:Z
{% if walg_enabled %}
Volume={{ walg_dir }}/bin:/opt/walg:ro,z
{% endif %}

# Quadlet doesn't have a direct `ulimits` mapping — pass through.
PodmanArgs=--ulimit nofile=65536:65536 --ulimit nproc=65536:65536

# Healthcheck: patroni's /readiness returns 200 only when patroni AND
# postgres are running. /health is too lenient — it returns 200 even
# when postgres failed to start (bind conflict, OOM, etc.) because the
# patroni HTTP server itself is fine. /readiness exercises the full path.
# -k tolerates cert-CN/127.0.0.1 mismatch; ca trust isn't the goal here,
# liveness is.
HealthCmd=curl -fsk --max-time 3 https://127.0.0.1:{{ patroni_api_port }}/readiness
HealthInterval=15s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=4
# On 4 consecutive failures (≈1 min), let systemd restart the container.
# Uses podman's `--health-on-failure=stop` then unit Restart=always brings
# it back up — clean cycle, no zombie postmaster.
HealthOnFailure=stop

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
