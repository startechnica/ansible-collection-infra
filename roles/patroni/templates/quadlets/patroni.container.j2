# Auto-generated by Ansible patroni role (Quadlet path).
# Patroni-managed PostgreSQL. Network=host so streaming replication
# peers identify each other by host:port (matching docker-compose
# semantics, no NAT in the path).
[Unit]
Description=Patroni-managed PostgreSQL
Wants=network-online.target etcd.service
After=network-online.target etcd.service
{% if patroni_walg_enabled %}
Requires=walg-init.service
After=walg-init.service
{% endif %}
Requires=etcd.service

[Container]
ContainerName=patroni
Image={{ patroni_image }}
User={{ patroni_uid }}
Group={{ patroni_gid }}
Network=host

Environment=PATRONI_CONFIG=/etc/patroni/patroni.yml
Environment=PATRONI_POSTGRESQL_DATA_DIR=/var/lib/postgresql/pg_data
Environment=PATRONI_POSTGRESQL_CONFIG_DIR=/var/lib/postgresql/pg_data
{% if patroni_pg_backend_oom_adjust_enabled | bool %}
# The container (and so the postmaster) runs at patroni_oom_score_adj, which is
# negative — protected. Without these, every forked backend would inherit that
# protection, so under host memory pressure the kernel would either skip
# PostgreSQL entirely or pick the postmaster and take the instance down with it.
# These make the postmaster reset each child to a killable score, so a single
# backend dies and PostgreSQL does crash recovery instead of Patroni failing the
# node over. PostgreSQL's documented mechanism (9.5+); raising a child's
# oom_score_adj never requires privileges.
Environment=PG_OOM_ADJUST_FILE=/proc/self/oom_score_adj
Environment=PG_OOM_ADJUST_VALUE={{ patroni_pg_backend_oom_score_adj }}
{% endif %}
{% if patroni_walg_enabled %}
EnvironmentFile={{ patroni_walg_dir }}/walg.env
{% endif %}

Volume={{ patroni_postgresql_root_dir }}:/var/lib/postgresql:Z
Volume={{ patroni_postgresql_log_dir }}:/var/log/postgresql:Z
Volume={{ patroni_certs_dir }}:/etc/certs:ro,Z
Volume={{ patroni_dir }}/patroni.yml:/etc/patroni/patroni.yml:ro,Z
Volume={{ patroni_wal_archive_dir }}:/wal_archive:Z
Volume={{ patroni_backup_dir }}:/var/lib/postgresql/backups:Z
{% if patroni_walg_enabled %}
Volume={{ patroni_walg_dir }}/bin:/opt/walg:ro,z
{% if patroni_walg_storage_type == 'gcs' %}
# GCS service-account key for wal-g (GOOGLE_APPLICATION_CREDENTIALS in
# walg.env points here). The DIRECTORY is mounted, not the bare file: a
# re-rendered key replaces the inode, which a file bind-mount would not
# follow.
Volume={{ patroni_walg_gcs_service_account_dir }}:{{ patroni_walg_gcs_service_account_mount }}:ro,Z
{% endif %}
{% endif %}

# Quadlet doesn't have a direct `ulimits` mapping — pass through.
# --oom-score-adj protects the postmaster from host-level OOM. Its backends are
# pushed back to a killable score by the environment set above, unless
# patroni_pg_backend_oom_adjust_enabled is false.
PodmanArgs=--ulimit nofile=65536:65536 --ulimit nproc=65536:65536 \
          --oom-score-adj={{ patroni_oom_score_adj }}

# Healthcheck: patroni's /readiness returns 200 only when patroni AND
# postgres are running. /health is too lenient — it returns 200 even
# when postgres failed to start (bind conflict, OOM, etc.) because the
# patroni HTTP server itself is fine. /readiness exercises the full path.
# -k tolerates cert-CN/127.0.0.1 mismatch; ca trust isn't the goal here,
# liveness is.
HealthCmd=curl -fsk --max-time 3 https://127.0.0.1:{{ patroni_api_port }}/readiness
HealthInterval=15s
HealthTimeout=5s
HealthStartPeriod=60s
HealthRetries=4
# On 4 consecutive failures (≈1 min), let systemd restart the container.
# Uses podman's `--health-on-failure=stop` then unit Restart=always brings
# it back up — clean cycle, no zombie postmaster.
HealthOnFailure=stop

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
