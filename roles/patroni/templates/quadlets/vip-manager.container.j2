# Auto-generated by Ansible patroni role (Quadlet path).
# vip-manager: Patroni-aware floating IP via etcd. Built locally
# from templates/dockerfiles/vip-manager.Dockerfile.j2 ahead of this
# Quadlet — see tasks/deploy/podman.yml.
[Unit]
Description=vip-manager (Patroni-aware VIP via etcd)
Wants=network-online.target etcd.service
After=network-online.target etcd.service
Requires=etcd.service

[Container]
ContainerName=vip-manager
Image=localhost/vip-manager:v{{ vip_manager_version }}
Network=host

# CAP_NET_ADMIN + CAP_NET_RAW: needed to add/remove the VIP on the
# host's network interface. Quadlet syntax for capabilities.
AddCapability=NET_ADMIN
AddCapability=NET_RAW

Volume={{ vip_manager_dir }}/vip-manager.yml:/etc/default/vip-manager.yml:ro,Z
Volume={{ vip_manager_certs_dir }}:/etc/certs:ro,Z

# vip-manager has no health endpoint of its own. Best proxy for
# liveness is "can it still talk to etcd?" — without etcd it can't
# decide who holds the leader key, so the VIP can't move correctly.
HealthCmd=curl -sf --cert /etc/certs/vip-manager.crt --key /etc/certs/vip-manager.key --cacert /etc/certs/ca.crt https://127.0.0.1:{{ etcd_client_port }}/health -o /dev/null || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
