# Auto-generated by Ansible patroni role (Quadlet path).
# One-shot init: copies the wal-g binary out of the official walg image
# into a host directory ({{ walg_dir }}/bin) so the patroni container
# can invoke it via volume mount without baking it into the patroni
# image. Mirrors the docker-compose `walg-init` service with
# `restart: "no"`. Fires once per boot or daemon-reload, exits.
{% if not walg_enabled %}
# (rendered only when walg_enabled — no-op file body kept for clarity)
{% endif %}
[Unit]
Description=WAL-G binary install (one-shot)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=walg-init
Image={{ walg_image }}
Network=host

Entrypoint=/bin/sh
Exec=-c "cp /usr/local/bin/wal-g /opt/walg/wal-g && chmod 755 /opt/walg/wal-g"

Volume={{ walg_dir }}/bin:/opt/walg:z

LogDriver=journald

[Service]
# One-shot: run to completion, mark as active, don't restart.
Type=oneshot
RemainAfterExit=true

[Install]
WantedBy=multi-user.target default.target
