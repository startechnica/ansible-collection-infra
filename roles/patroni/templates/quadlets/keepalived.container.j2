# Auto-generated by Ansible patroni role (Quadlet path).
# keepalived: VRRP-based VIP fallback (used when use_vip_manager=false).
# Built locally from templates/dockerfiles/keepalived.Dockerfile.j2.
[Unit]
Description=keepalived (VRRP-based VIP)
Wants=network-online.target haproxy.service
After=network-online.target haproxy.service
Requires=haproxy.service

[Container]
ContainerName=keepalived
Image=localhost/keepalived:latest
Network=host

# VRRP advertises via multicast / unicast and manipulates routing,
# so all three caps are required.
AddCapability=NET_ADMIN
AddCapability=NET_BROADCAST
AddCapability=NET_RAW

Volume={{ keepalived_dir }}/keepalived.conf:/etc/keepalived/keepalived.conf:ro,Z
Volume={{ haproxy_certs_dir }}:/etc/certs:ro,z

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
