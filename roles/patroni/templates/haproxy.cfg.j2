global
    # Process-wide ceiling every listener below draws from. It must exceed their
    # sum, or a frontend's own cap stops being the effective limit — see
    # patroni_haproxy_global_maxconn in defaults/main/haproxy.yml.
    maxconn {{ patroni_haproxy_global_maxconn }}
    log stdout format raw local0

defaults
    mode tcp
    log global
    retries 3

    # Log connection close with timers. In TCP mode the `Tw` field is time
    # spent QUEUED waiting for a server slot — direct evidence of backend
    # saturation that would otherwise have to be inferred from client-side
    # timeouts.
    # Volume note: one line per connection close. If that is too chatty at
    # scale, drop it and rely on the Prometheus metrics from the stats listener.
    option tcplog

    # INACTIVITY timers — time since application data last moved in that
    # direction. In mode tcp `timeout tunnel` below takes over as soon as no
    # analyser remains attached to the connection, and nothing here attaches
    # one: the pg listeners have no tcp-request content / inspect-delay rules
    # and no TLS on their bind lines. So client/server effectively govern only
    # the mode-http `listen stats` block, and stand as backstops should a
    # tcp-request rule ever be added. `timeout connect` is the one that bounds
    # backend connection setup.
    timeout client {{ patroni_haproxy_client_timeout }}
    timeout connect {{ patroni_haproxy_connect_timeout }}
    timeout server {{ patroni_haproxy_server_timeout }}
    timeout check {{ patroni_haproxy_check_timeout }}

    # Time a connection may sit in a server queue once `maxconn` on a server
    # line is reached. Unset, it inherits `timeout connect`; with `retries 3`
    # stacked on top a saturated backend shows up as a multi-second stall that
    # looks like a database problem. An explicit short value makes saturation
    # fail fast and legibly.
    timeout queue 5s

    # In mode tcp this supersedes timeout client/server once no analyser is
    # attached, which is what lets legitimately idle sessions survive:
    #   * LISTEN/NOTIFY clients sit silent between notifications, sometimes
    #     for hours. NOTIFY is not queued for absent listeners, so a
    #     proxy-side disconnect loses every notification in the gap —
    #     silently, with no error until the client next touches the socket.
    #   * Long statements (CREATE INDEX, analytical queries, pg_dump) move
    #     no bytes while running. PgBouncer intentionally doesn't cap them
    #     (query_timeout = 0), so this is the only limit in the path.
    timeout tunnel {{ patroni_haproxy_tunnel_timeout }}

    # Cap half-closed (FIN sent, peer hasn't closed back) connections so
    # FDs from abrupt client/PgBouncer disconnects free quickly. These
    # explicitly OVERRIDE `timeout tunnel` once a connection is shut down in
    # one direction, so they — not the tunnel timeout above — are what bounds
    # FIN_WAIT. Without them a lossy-network disconnect holds its slot for the
    # full tunnel window.
    timeout client-fin {{ patroni_haproxy_client_fin_timeout }}
    timeout server-fin {{ patroni_haproxy_server_fin_timeout }}

    # Kernel TCP keepalives on both client- and server-side sockets. With
    # os_tuning.yml's tcp_keepalive_time=60 / intvl=10 / probes=6, a dead
    # peer (NAT timeout, crashed PgBouncer/PG) is detected ~2 min after the
    # connection goes idle — important for PgBouncer's pooled server
    # connections that can sit idle up to `server_lifetime=3600s`.
    #
    # NOTE: keepalives do NOT reset the inactivity timers above — a probe is
    # an empty ACK with no application data. Dead peers are reaped here, by
    # the kernel; the timeouts above are a separate backstop. That split is
    # why `timeout tunnel` can safely be hours long.
    option clitcpka
    option srvtcpka

listen stats
    mode http
    bind *:{{ patroni_haproxy_stats_port }}

    # Frontend cap. Same argument as pg-primary/pg-replicas: unset, this
    # inherits `global maxconn` (4000) and a monitoring endpoint could claim
    # the whole process budget. 100 is far more than a Prometheus scrape plus
    # a few humans.
    #
    # Side effect worth knowing: this also changes what the BACKEND row of the
    # stats page reports in its "Session limit" column — see the note below.
    maxconn 100

    stats enable
    stats uri /
    stats refresh 10s

    # Prometheus endpoint for a metrics scraper. Alerts worth wiring:
    #   haproxy_server_current_sessions / haproxy_server_limit_sessions > 0.8
    #   non-zero queue depth (backend saturation, directly)
    #   backend server state flapping (a flapping /primary check reads as a DB outage)
    http-request use-service prometheus-exporter if { path /metrics }

    # READING THIS PAGE — the "Session limit" column means DIFFERENT things per row:
    #   frontend / listener / server rows -> that object's `maxconn`
    #   BACKEND rows                      -> `fullconn`, which is NOT set anywhere here,
    #                                        so HAProxy derives it as the sum of the
    #                                        session limits of the frontends routing to
    #                                        that backend, divided by 10.
    #
    # A backend showing {{ (patroni_haproxy_global_maxconn | int / 10) | int }} therefore means its frontend is at
    # {{ patroni_haproxy_global_maxconn }} — i.e. inheriting `global maxconn` instead of carrying its own
    # cap. Useful as a check that the frontend maxconn lines below actually took
    # effect (these figures are rendered from the vars, so they cannot go stale):
    #   pg-primary  {{ patroni_haproxy_primary_maxconn }} -> backend {{ (patroni_haproxy_primary_maxconn | int / 10) | int }}
    #   pg-replicas {{ patroni_haproxy_replicas_maxconn }} -> backend {{ (patroni_haproxy_replicas_maxconn | int / 10) | int }}
    #   pg-direct   {{ patroni_haproxy_direct_maxconn }} -> backend {{ (patroni_haproxy_direct_maxconn | int / 10) | int }}
    #   stats       100 -> backend 10
    # If pg-primary's backend row reads {{ (patroni_haproxy_global_maxconn | int / 10) | int }}, its `maxconn
    # {{ patroni_haproxy_primary_maxconn }}` is not live and the server-side limit cannot queue as intended.
    #
    # fullconn does NOT cap anything in this config. It only scales a server's effective
    # limit when the server line carries BOTH `minconn` and `maxconn`; ours have only
    # `maxconn`, so the per-server limit is static and fullconn is a display value.

listen pg-primary
    bind *:{{ patroni_haproxy_primary_port }}

    # Frontend cap — limits what HAProxy ACCEPTS on this entry. Unset, it
    # inherits `global maxconn` ({{ patroni_haproxy_global_maxconn }}) and this one entry could consume
    # the whole process budget.
    #
    # MUST stay ABOVE the server-side maxconn below ({{ patroni_haproxy_primary_maxconn }} > {{ patroni_haproxy_primary_server_maxconn }}). The frontend
    # accepts, the server line forwards; keeping the frontend higher means the excess
    # queues visibly inside HAProxy (`timeout queue`, and the Tw field in the tcplog)
    # instead of being refused at accept and left in the kernel backlog. Raising the
    # server line without raising this one has no effect.
    maxconn {{ patroni_haproxy_primary_maxconn }}

    option httpchk GET /primary
    http-check expect status 200
    default-server inter {{ patroni_haproxy_check_inter }} fall {{ patroni_haproxy_check_fall }} rise {{ patroni_haproxy_check_rise }} on-marked-down shutdown-sessions

{% for node in patroni_nodes %}
    server {{ node.name }} {{ node.ipv4 }}:{{ patroni_pgbouncer_port }} maxconn {{ patroni_haproxy_primary_server_maxconn }} check port {{ patroni_api_port }} check-ssl ca-file /etc/certs/ca.crt crt /etc/certs/haproxy-client.pem verify required
{% endfor %}

listen pg-replicas
    bind *:{{ patroni_haproxy_replicas_port }}

    # Frontend cap, for the same reason as pg-primary: without it this entry
    # inherits `global maxconn` ({{ patroni_haproxy_global_maxconn }}) and an unused endpoint could starve
    # the one that matters.
    #
    # Sized like pg-primary rather than to the replica count: every replica passing
    # the /replica check contributes {{ patroni_haproxy_replicas_server_maxconn }} on the server side
    # ({{ patroni_haproxy_replicas_server_maxconn | int * 3 }} for a three-node cluster), and these are client connections to
    # PgBouncer, so the ceiling that matters is its max_client_conn — not PostgreSQL's
    # max_connections. Raise this and the server line together.
    maxconn {{ patroni_haproxy_replicas_maxconn }}

    balance roundrobin
    option httpchk GET /replica
    http-check expect status 200
    default-server inter {{ patroni_haproxy_check_inter }} fall {{ patroni_haproxy_check_fall }} rise {{ patroni_haproxy_check_rise }} on-marked-down shutdown-sessions

{% for node in patroni_nodes %}
    server {{ node.name }} {{ node.ipv4 }}:{{ patroni_pgbouncer_port }} maxconn {{ patroni_haproxy_replicas_server_maxconn }} check port {{ patroni_api_port }} check-ssl ca-file /etc/certs/ca.crt crt /etc/certs/haproxy-client.pem verify required
{% endfor %}

# POOLER BYPASS, direct to the Patroni leader.
listen pg-direct
    bind *:{{ patroni_haproxy_direct_port }}

    # Frontend cap: accepts up to {{ patroni_haproxy_direct_maxconn }}, above the server-side limit of
    # {{ patroni_haproxy_direct_server_maxconn }} below, so excess connections queue inside HAProxy
    # (`timeout queue`) rather than being refused at accept — same pattern as
    # pg-primary. Both are an order of magnitude below the pooled listeners
    # because this path spends PostgreSQL backends directly; see
    # patroni_haproxy_direct_maxconn in defaults/main/haproxy.yml.
    maxconn {{ patroni_haproxy_direct_maxconn }}

    option httpchk GET /primary
    http-check expect status 200
    default-server inter 3s fall 5 rise 2 on-marked-down shutdown-sessions

    # Server-side `maxconn {{ patroni_haproxy_direct_server_maxconn }}`: unpooled clients (schema migrations, admin
    # tooling) are low-concurrency. Deliberately small so a runaway job cannot
    # consume the leader's max_connections through the unpooled path — the first
    # casualty of that would be PgBouncer's pool, i.e. the whole application.
    #
    # No timeout overrides here on purpose — the long `timeout tunnel` from
    # defaults is what a long ALTER TABLE needs, since it sends nothing on the
    # socket for its duration. If timeout tunnel is ever removed from defaults,
    # set it explicitly HERE first.
{% for node in patroni_nodes %}
    server {{ node.name }} {{ node.ipv4 }}:{{ patroni_postgresql_port }} maxconn {{ patroni_haproxy_direct_server_maxconn }} check port {{ patroni_api_port }} check-ssl ca-file /etc/certs/ca.crt crt /etc/certs/haproxy-client.pem verify required
{% endfor %}
