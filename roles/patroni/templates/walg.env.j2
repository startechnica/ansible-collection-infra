# {{ ansible_managed }}
{#
  Resolve the archive location once, then emit the backend-specific env.

  Prefix precedence (identical for both backends):
    1. Standby with an explicit primary prefix — wal-fetch must read the
       PRIMARY's archive so restore_command can pull the primary's WAL when
       the live stream is unavailable.
    2. This cluster's own prefix (default: patroni-walg-<patroni_scope>) —
       keeps multiple Patroni clusters from colliding at the bucket root
       (WAL-G has no built-in scope namespacing).
    3. Empty prefix — bucket root.
#}
{% if (patroni_standby_enabled | default(false) | bool) and (patroni_standby_primary_walg_prefix | default('') | length > 0) %}
{%   set _walg_prefix = patroni_standby_primary_walg_prefix | regex_replace('/$', '') %}
{% elif walg_storage_type == 'gcs' %}
{%   set _walg_prefix = walg_gcs_prefix | default('') | regex_replace('/$', '') %}
{% else %}
{%   set _walg_prefix = patroni_walg_s3_prefix | default('') | regex_replace('/$', '') %}
{% endif %}
{% if walg_storage_type == 'gcs' %}
# ── Native Google Cloud Storage backend ──────────────────────────────────
# WAL-G's GCS driver uses the Google SDK's default credential chain; pointing
# it at the service-account key mounted read-only from walg_gcs_service_account_dir
# keeps the private key out of this env file (and out of `podman inspect`).
GOOGLE_APPLICATION_CREDENTIALS={{ walg_gcs_service_account_path }}
{% else %}
# ── S3 backend (AWS S3, MinIO, Ceph, S3-compatible gateways) ─────────────
AWS_ACCESS_KEY_ID={{ s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ s3_secret_key }}
AWS_REGION={{ s3_region }}
AWS_ENDPOINT={{ s3_endpoint }}
AWS_S3_FORCE_PATH_STYLE={{ s3_force_path_style }}
{% endif %}

WALG_COMPRESSION_METHOD={{ walg_compression }}
{% if (patroni_standby_enabled | default(false) | bool) and (patroni_standby_primary_walg_prefix | default('') | length > 0) %}
# Standby: wal-fetch fallback reads the PRIMARY's archive prefix (same bucket).
{% endif %}
{% if walg_storage_type == 'gcs' %}
WALG_GS_PREFIX=gs://{{ walg_gcs_bucket }}{{ ('/' ~ _walg_prefix) if _walg_prefix | length > 0 else '' }}
{% else %}
WALG_S3_PREFIX=s3://{{ s3_bucket }}{{ ('/' ~ _walg_prefix) if _walg_prefix | length > 0 else '' }}
{% endif %}

PGHOST=127.0.0.1
PGPORT={{ postgresql_port }}
PGUSER={{ walg_auth_user }}
PGPASSWORD={{ walg_auth_password }}
# Without this, wal-g defaults the database name to PGUSER (walg) and the
# connection fails with: FATAL: database "walg" does not exist.
PGDATABASE=postgres
PGDATA=/var/lib/postgresql/pg_data
