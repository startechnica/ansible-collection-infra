# {{ ansible_managed }}
AWS_ACCESS_KEY_ID={{ s3_access_key }}
AWS_SECRET_ACCESS_KEY={{ s3_secret_key }}
AWS_REGION={{ s3_region }}
AWS_ENDPOINT={{ s3_endpoint }}
AWS_S3_FORCE_PATH_STYLE={{ s3_force_path_style }}

WALG_COMPRESSION_METHOD={{ walg_compression }}
{% if (patroni_standby_enabled | default(false) | bool) and (patroni_standby_primary_walg_prefix | default('') | length > 0) %}
# Standby: wal-fetch fallback reads the PRIMARY's archive prefix (same bucket) so
# restore_command can pull the primary's WAL when the live stream is unavailable.
WALG_S3_PREFIX=s3://{{ s3_bucket }}/{{ patroni_standby_primary_walg_prefix | regex_replace('/$', '') }}
{% elif patroni_walg_s3_prefix | default('') | length > 0 %}
# Per-cluster prefix (default: patroni-walg-<patroni_scope>) — keeps multiple
# Patroni clusters from colliding at the bucket root (WAL-G has no built-in
# scope namespacing). Set patroni_walg_s3_prefix="" to use the bucket root.
WALG_S3_PREFIX=s3://{{ s3_bucket }}/{{ patroni_walg_s3_prefix | regex_replace('/$', '') }}
{% else %}
WALG_S3_PREFIX=s3://{{ s3_bucket }}
{% endif %}

PGHOST=127.0.0.1
PGPORT={{ postgresql_port }}
PGUSER={{ walg_auth_user }}
PGPASSWORD={{ walg_auth_password }}
# Without this, wal-g defaults the database name to PGUSER (walg) and the
# connection fails with: FATAL: database "walg" does not exist.
PGDATABASE=postgres
PGDATA=/var/lib/postgresql/pg_data
