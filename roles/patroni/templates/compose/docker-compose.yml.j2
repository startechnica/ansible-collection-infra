# Managed by Ansible
---
services:
  # ── etcd ──────────────────────────────────────────────────────────
  etcd:
    image: {{ patroni_etcd_image }}
    container_name: etcd
    restart: unless-stopped
    network_mode: host
    user: "{{ patroni_etcd_uid }}:{{ patroni_etcd_gid }}"
    command:
      - etcd
      - --name=etcd-{{ node_ip }}
      - --data-dir=/etcd-data
      # Client TLS
      - --listen-client-urls=https://0.0.0.0:{{ patroni_etcd_client_port }}
      - --advertise-client-urls=https://{{ node_ip }}:{{ patroni_etcd_client_port }}
      - --cert-file=/etc/certs/etcd-server.crt
      - --key-file=/etc/certs/etcd-server.key
      - --trusted-ca-file=/etc/certs/ca.crt
      - --client-cert-auth=true
      # Peer TLS
      - --listen-peer-urls=https://0.0.0.0:{{ patroni_etcd_peer_port }}
      - --initial-advertise-peer-urls=https://{{ node_ip }}:{{ patroni_etcd_peer_port }}
      - --peer-cert-file=/etc/certs/etcd-peer.crt
      - --peer-key-file=/etc/certs/etcd-peer.key
      - --peer-trusted-ca-file=/etc/certs/ca.crt
      - --peer-client-cert-auth=true
      # Cluster
      - --initial-cluster={% for ip in node_ips %}etcd-{{ ip }}=https://{{ ip }}:{{ patroni_etcd_peer_port }}{% if not loop.last %},{% endif %}{% endfor %}

      - --initial-cluster-state={{ etcd_cluster_state }}
      - --initial-cluster-token={{ patroni_scope }}
{% if patroni_etcd_auto_compaction_mode | length > 0 %}
      # History compaction; see patroni_etcd_auto_compaction_mode in defaults.
      - --auto-compaction-mode={{ patroni_etcd_auto_compaction_mode }}
      - --auto-compaction-retention={{ patroni_etcd_auto_compaction_retention }}
{% endif %}
    volumes:
      - {{ patroni_etcd_data_dir }}:/etcd-data:Z
      - {{ patroni_etcd_certs_dir }}:/etc/certs:ro,Z
    # Host-level OOM victim bias — most strongly protected container in the
    # stack; see patroni_etcd_oom_score_adj in defaults.
    oom_score_adj: {{ patroni_etcd_oom_score_adj }}
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
        tag: "etcd"

{% if patroni_walg_enabled %}
  # ── WAL-G init (copies wal-g binary to shared volume) ────────────
  walg-init:
    image: {{ patroni_walg_image }}
    container_name: walg-init
    restart: "no"
    network_mode: host
    entrypoint:
      - /bin/sh
      - -c
      - "cp /usr/local/bin/wal-g /opt/walg/wal-g && chmod 755 /opt/walg/wal-g"
    volumes:
      - {{ patroni_walg_dir }}/bin:/opt/walg:z

{% endif %}
  # ── Patroni (PostgreSQL + Patroni) ───────────────────────────────
  patroni:
    image: {{ patroni_image }}
    container_name: patroni
    restart: unless-stopped
    network_mode: host
    user: "{{ patroni_uid }}:{{ patroni_gid }}"
    environment:
      PATRONI_CONFIG: /etc/patroni/patroni.yml
      PATRONI_POSTGRESQL_DATA_DIR: /var/lib/postgresql/pg_data
      PATRONI_POSTGRESQL_CONFIG_DIR: /var/lib/postgresql/pg_data
{% if patroni_pg_backend_oom_adjust_enabled | bool %}
      # Postmaster runs protected (oom_score_adj below); these push each forked
      # backend back to a killable score so a single backend is the OOM victim
      # and PostgreSQL crash-recovers instead of Patroni failing the node over.
      # See patroni_pg_backend_oom_score_adj in defaults.
      PG_OOM_ADJUST_FILE: /proc/self/oom_score_adj
      PG_OOM_ADJUST_VALUE: "{{ patroni_pg_backend_oom_score_adj }}"
{% endif %}
{% if patroni_walg_enabled %}
    env_file:
      - {{ patroni_walg_dir }}/walg.env
{% endif %}
    volumes:
      - {{ patroni_postgresql_root_dir }}:/var/lib/postgresql:Z
      - {{ patroni_postgresql_log_dir }}:/var/log/postgresql:Z
      - {{ patroni_certs_dir }}:/etc/certs:ro,Z
      - {{ patroni_dir }}/patroni.yml:/etc/patroni/patroni.yml:ro,Z
      - {{ patroni_wal_archive_dir }}:/wal_archive:Z
      - {{ patroni_backup_dir }}:/var/lib/postgresql/backups:Z
{% if patroni_walg_enabled %}
      - {{ patroni_walg_dir }}/bin:/opt/walg:ro,z
{% if patroni_walg_storage_type == 'gcs' %}
      # GCS service-account key for wal-g (GOOGLE_APPLICATION_CREDENTIALS in
      # walg.env points here). The DIRECTORY is mounted, not the bare file: a
      # re-rendered key replaces the inode, which a file bind-mount would not
      # follow.
      - {{ patroni_walg_gcs_service_account_dir }}:{{ patroni_walg_gcs_service_account_mount }}:ro,Z
{% endif %}
{% endif %}
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
      nproc:
        soft: 65536
        hard: 65536
    oom_score_adj: {{ patroni_oom_score_adj }}
    depends_on:
      # Long (mapping) form throughout — the walg-init entry needs
      # `condition:`, and compose forbids mixing the short list form with
      # mapping entries under one depends_on (invalid YAML: a block sequence
      # and a block mapping at the same level).
      etcd:
        condition: service_started
{% if patroni_walg_enabled %}
      walg-init:
        condition: service_completed_successfully
{% endif %}
    healthcheck:
      # /readiness returns 200 only when patroni AND postgres are running.
      # /health is too lenient — returns 200 even with postgres dead (bind
      # conflict, OOM, etc.) because the patroni HTTP server itself is fine.
      # -k tolerates cert-CN/127.0.0.1 mismatch.
      test: ["CMD-SHELL", "curl -fsk --max-time 3 https://127.0.0.1:{{ patroni_api_port }}/readiness || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 4
      start_period: 60s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "5"
        tag: "patroni"

  # ── HAProxy ───────────────────────────────────────────────────────
  haproxy:
    image: {{ patroni_haproxy_image }}
    container_name: haproxy
    restart: unless-stopped
    network_mode: host
    user: "99:99"
    volumes:
      - {{ patroni_haproxy_dir }}/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro,Z
      - {{ patroni_haproxy_certs_dir }}:/etc/certs:ro,z
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    oom_score_adj: {{ patroni_haproxy_oom_score_adj }}
    healthcheck:
      # Stats endpoint always returns 200 once haproxy has parsed its config
      # and is accepting connections — proves both the process is up and
      # the config didn't reject at parse time.
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:{{ patroni_haproxy_stats_port }}/ || exit 1"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
        tag: "haproxy"

  # ── PgBouncer ─────────────────────────────────────────────────────
  pgbouncer:
    image: {{ patroni_pgbouncer_image }}
    container_name: pgbouncer
    restart: unless-stopped
    network_mode: host
    user: "{{ patroni_pgbouncer_uid }}:{{ patroni_pgbouncer_gid }}"
    volumes:
      - {{ patroni_pgbouncer_dir }}/pgbouncer.ini:/etc/pgbouncer/pgbouncer.ini:ro,Z
      - {{ patroni_pgbouncer_dir }}/userlist.txt:/etc/pgbouncer/userlist.txt:ro,Z
      - {{ patroni_pgbouncer_certs_dir }}:/etc/certs:ro,Z
    ulimits:
      nofile:
        soft: 65536
        hard: 65536
    oom_score_adj: {{ patroni_pgbouncer_oom_score_adj }}
    depends_on:
      - patroni
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
        tag: "pgbouncer"

{% if patroni_vip_enabled %}
{% if use_vip_manager %}
  # ── vip-manager (Patroni-aware VIP via etcd) ─────────────────────
  vip-manager:
    build:
      context: {{ patroni_vip_manager_dir }}
    image: vip-manager:v{{ patroni_vip_manager_version }}
    container_name: vip-manager
    restart: unless-stopped
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_RAW
    volumes:
      - {{ patroni_vip_manager_dir }}/vip-manager.yml:/etc/default/vip-manager.yml:ro,Z
      - {{ patroni_vip_manager_certs_dir }}:/etc/certs:ro,Z
    # Holds the VIP — a kill moves client traffic. See patroni_vip_manager_oom_score_adj.
    oom_score_adj: {{ patroni_vip_manager_oom_score_adj }}
    depends_on:
      - etcd
    healthcheck:
      # vip-manager has no health endpoint of its own. Best proxy for
      # liveness is "can it still talk to etcd?" — without etcd it can't
      # decide who holds the leader key, so the VIP can't move correctly.
      # Uses vip-manager's own client cert (already mounted).
      test: ["CMD-SHELL", "curl -sf --cert /etc/certs/vip-manager.crt --key /etc/certs/vip-manager.key --cacert /etc/certs/ca.crt https://127.0.0.1:{{ patroni_etcd_client_port }}/health -o /dev/null || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
        tag: "vip-manager"
{% else %}
  # ── Keepalived (VRRP-based VIP) ──────────────────────────────────
  keepalived:
    build:
      context: {{ patroni_keepalived_dir }}
    image: keepalived:latest
    container_name: keepalived
    restart: unless-stopped
    network_mode: host
    cap_add:
      - NET_ADMIN
      - NET_BROADCAST
      - NET_RAW
    volumes:
      - {{ patroni_keepalived_dir }}/keepalived.conf:/etc/keepalived/keepalived.conf:ro,Z
      - {{ patroni_haproxy_certs_dir }}:/etc/certs:ro,z
    # Holds the VIP — a kill moves client traffic. See patroni_keepalived_oom_score_adj.
    oom_score_adj: {{ patroni_keepalived_oom_score_adj }}
    depends_on:
      - haproxy
    logging:
      driver: json-file
      options:
        max-size: "100m"
        max-file: "3"
        tag: "keepalived"
{% endif %}
{% endif %}

{% if patroni_postgres_exporter_enabled | bool %}
  # ── postgres_exporter (Prometheus metrics) ───────────────────────
  postgres-exporter:
    image: {{ patroni_postgres_exporter_image }}
    container_name: postgres-exporter
    restart: unless-stopped
    network_mode: host
    environment:
      DATA_SOURCE_NAME: "postgresql://postgres:{{ patroni_postgresql_postgres_password }}@127.0.0.1:{{ patroni_postgresql_port }}/postgres?sslmode=disable"
    depends_on:
      - patroni
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
        tag: "postgres-exporter"
    deploy:
      resources:
        limits:
          memory: {{ patroni_postgres_exporter_mem_limit_mb }}m
    # Telemetry only — first in line for the OOM killer.
    oom_score_adj: {{ patroni_postgres_exporter_oom_score_adj }}
{% endif %}

# walg-cron service removed — scheduled backups now run via host-level
# systemd timer (walg-cron.timer → walg-cron.service → walg-backup.sh,
# rendered by tasks/shared/walg.yml). On-demand backups via
# `patroni_action: backup` continue to exec into the patroni container.
