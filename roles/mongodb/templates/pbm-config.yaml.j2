# {{ ansible_managed }}
# Percona Backup for MongoDB — storage + PITR configuration.
# Applied cluster-wide once via `pbm config --file`; PBM persists it inside the
# cluster. This rendered file is the declarative source of truth.
storage:
  type: {{ mongodb_backup_storage_type }}
{% if mongodb_backup_storage_type == 'minio' %}
  minio:
    region: "{{ s3_region }}"
    # PBM's MinIO client requires host[:port] without a URL scheme. Keep the
    # shared s3_endpoint URL-shaped for mc/WAL-G and derive MinIO's form here.
    endpoint: "{{ s3_endpoint | regex_replace('^https?://', '') | regex_replace('/+$', '') }}"
    secure: {{ 'true' if s3_endpoint | lower | regex_search('^https://') else 'false' }}
    forcePathStyle: {{ 'true' if s3_force_path_style | bool else 'false' }}
    bucket: "{{ s3_bucket }}"
    prefix: "{{ mongodb_backup_s3_prefix }}/pbm"
    credentials:
      access-key-id: "{{ s3_access_key }}"
      secret-access-key: "{{ s3_secret_key }}"
{% elif mongodb_backup_storage_type == 's3' %}
  s3:
    region: "{{ s3_region }}"
    endpointUrl: "{{ s3_endpoint }}"
    forcePathStyle: {{ 'true' if s3_force_path_style | bool else 'false' }}
    bucket: "{{ s3_bucket }}"
    prefix: "{{ mongodb_backup_s3_prefix }}/pbm"
    credentials:
      access-key-id: "{{ s3_access_key }}"
      secret-access-key: "{{ s3_secret_key }}"
{% elif mongodb_backup_storage_type == 'gcs' %}
{%   set _gcs_sa = mongodb_backup_gcs_service_account if mongodb_backup_gcs_service_account is mapping else (mongodb_backup_gcs_service_account | from_json) %}
  gcs:
    bucket: {{ mongodb_backup_gcs_bucket | to_json }}
    prefix: {{ (mongodb_backup_gcs_prefix ~ '/pbm') | to_json }}
    credentials:
      clientEmail: {{ _gcs_sa.client_email | to_json }}
      # JSON quoting preserves the service-account key's embedded newlines.
      privateKey: {{ _gcs_sa.private_key | to_json }}
{% endif %}
pitr:
  enabled: {{ 'true' if mongodb_backup_pitr_enabled | bool else 'false' }}
  compression: {{ mongodb_backup_compression_type }}
{% if mongodb_backup_compression_level | string | length > 0 %}
  compressionLevel: {{ mongodb_backup_compression_level }}
{% endif %}
