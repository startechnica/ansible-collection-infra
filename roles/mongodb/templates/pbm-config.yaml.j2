# {{ ansible_managed }}
# Percona Backup for MongoDB — storage + PITR configuration.
# Applied cluster-wide once via `pbm config --file`; PBM persists it inside the
# cluster. This rendered file is the declarative source of truth. Reuses the
# shared s3_* vars (native S3 — not the mc client path).
storage:
  type: s3
  s3:
    region: "{{ s3_region }}"
    endpointUrl: "{{ s3_endpoint }}"
    forcePathStyle: {{ 'true' if s3_force_path_style | bool else 'false' }}
    bucket: "{{ s3_bucket }}"
    prefix: "{{ s3_prefix }}/pbm"
    credentials:
      access-key-id: "{{ s3_access_key }}"
      secret-access-key: "{{ s3_secret_key }}"
pitr:
  enabled: {{ 'true' if mongodb_pbm_pitr | bool else 'false' }}
  compression: {{ mongodb_pbm_compression }}
