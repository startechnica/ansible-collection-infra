# Auto-generated by Ansible mongodb role
# MongoDB {{ mongodb_cluster_type }} cluster
services:
  mongod:
    image: {{ mongodb_image_registry }}/{{ mongodb_image_repository }}:{{ mongodb_image_tag }}
    container_name: mongodb-mongod
    user: "{{ mongodb_uid }}:{{ mongodb_gid }}"
    restart: unless-stopped
    command:
      - mongod
      - {{ '--transitionToAuth' if mongodb_bootstrap | default(false) | bool else '--auth' }}
{% if mongodb_cluster_type == 'sharded' %}
      - --shardsvr
{% endif %}
      - "--port=27017"
      - "--replSet={{ mongodb_shard_replset }}"
      # WiredTiger cache must be a FRACTION of the container memory limit
      # — mongod also needs memory for connections, working set, TLS, etc.
      # Setting cache == limit guarantees OOM-kill cycles. 50% is the
      # MongoDB-recommended split between WT cache and everything else.
      - "--wiredTigerCacheSizeGB={{ (mongodb_mongod_mem_limit_mb * 0.5 / 1024) | float | round(2) }}"
      - --bind_ip_all
      - --quiet
      - "--tlsMode={{ mongodb_mongod_tls_mode }}"
      - "--tlsCertificateKeyFile=/etc/mongo/ssl/mongodb-mongod.pem"
      - "--tlsCAFile=/etc/mongo/ssl/ca.pem"
      - "--tlsClusterFile=/etc/mongo/ssl/mongodb-mongod.pem"
      - "--clusterAuthMode=x509"
      - "--tlsAllowConnectionsWithoutCertificates"
    volumes:
      - {{ mongodb_mongod_data_dir }}:/data/db:Z
      - {{ mongodb_tls_dir }}/mongodb-mongod.pem:/etc/mongo/ssl/mongodb-mongod.pem:ro,Z
      - {{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
      - {{ mongodb_tls_dir }}/healthcheck.pem:/etc/mongo/ssl/healthcheck.pem:ro,z
    networks:
      - {{ mongodb_network }}
    ports:
      - "{{ mongodb_mongod_node_port }}:27017"
{% if mongodb_cluster_type == 'replicaset' and mongodb_exporter_enabled | bool %}
      - "{{ mongodb_exporter_port }}:{{ mongodb_exporter_port }}"
{% endif %}
    ulimits:
      nofile:
        soft: {{ mongodb_ulimit_nofile }}
        hard: {{ mongodb_ulimit_nofile }}
      nproc:
        soft: -1
        hard: -1
    healthcheck:
      test: ["CMD", "mongosh", "--port", "27017", "--quiet", "--tls", "--tlsCertificateKeyFile", "/etc/mongo/ssl/healthcheck.pem", "--tlsCAFile", "/etc/mongo/ssl/ca.pem", "--authenticationMechanism", "MONGODB-X509", "--authenticationDatabase", "$$external", "--eval", "db.adminCommand('ping')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "5"
    deploy:
      resources:
        limits:
          memory: {{ mongodb_mongod_mem_limit_mb }}m
    # Host-level OOM victim bias — see mongodb_mongod_oom_score_adj in defaults.
    oom_score_adj: {{ mongodb_mongod_oom_score_adj }}

{% if mongodb_cluster_type == 'sharded' %}
  configsvr:
    image: {{ mongodb_image_registry }}/{{ mongodb_image_repository }}:{{ mongodb_image_tag }}
    container_name: mongodb-configsvr
    user: "{{ mongodb_uid }}:{{ mongodb_gid }}"
    restart: unless-stopped
    command:
      - mongod
      - {{ '--transitionToAuth' if mongodb_bootstrap | default(false) | bool else '--auth' }}
      - --configsvr
      - "--port=27017"
      - "--replSet={{ mongodb_config_replset }}"
      # See mongod's wiredTigerCacheSizeGB note above. Same 50% rule
      # applied to the configsvr's own memory limit.
      - "--wiredTigerCacheSizeGB={{ (mongodb_configsvr_mem_limit_mb * 0.5 / 1024) | float | round(2) }}"
      - --bind_ip_all
      - --quiet
      - "--tlsMode={{ mongodb_configsvr_tls_mode }}"
      - "--tlsCertificateKeyFile=/etc/mongo/ssl/mongodb-configsvr.pem"
      - "--tlsCAFile=/etc/mongo/ssl/ca.pem"
      - "--tlsClusterFile=/etc/mongo/ssl/mongodb-configsvr.pem"
      - "--clusterAuthMode=x509"
      - "--tlsAllowConnectionsWithoutCertificates"
    volumes:
      - {{ mongodb_configsvr_data_dir }}:/data/configdb:Z
      - {{ mongodb_tls_dir }}/mongodb-configsvr.pem:/etc/mongo/ssl/mongodb-configsvr.pem:ro,Z
      - {{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
      - {{ mongodb_tls_dir }}/healthcheck.pem:/etc/mongo/ssl/healthcheck.pem:ro,z
    networks:
      - {{ mongodb_network }}
    ports:
      - "{{ mongodb_configsvr_node_port }}:27017"
    ulimits:
      nofile:
        soft: {{ mongodb_ulimit_nofile }}
        hard: {{ mongodb_ulimit_nofile }}
      nproc:
        soft: -1
        hard: -1
    healthcheck:
      test: ["CMD", "mongosh", "--port", "27017", "--quiet", "--tls", "--tlsCertificateKeyFile", "/etc/mongo/ssl/healthcheck.pem", "--tlsCAFile", "/etc/mongo/ssl/ca.pem", "--authenticationMechanism", "MONGODB-X509", "--authenticationDatabase", "$$external", "--eval", "db.adminCommand('ping')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "5"
    deploy:
      resources:
        limits:
          memory: {{ mongodb_configsvr_mem_limit_mb }}m
    oom_score_adj: {{ mongodb_configsvr_oom_score_adj }}

  mongos:
    image: {{ mongodb_image_registry }}/{{ mongodb_image_repository }}:{{ mongodb_image_tag }}
    container_name: mongodb-mongos
    user: "{{ mongodb_uid }}:{{ mongodb_gid }}"
    restart: unless-stopped
    command:
      - mongos
{% if mongodb_bootstrap | default(false) | bool %}
      - "--transitionToAuth"
{% endif %}
      - --configdb
      - "{{ mongodb_config_replset }}/{{ mongodb_nodes | map(attribute='ipv4') | map('regex_replace', '^(.*)$', '\\1:' ~ mongodb_configsvr_node_port) | join(',') }}"
      - "--port=27017"
      - --bind_ip_all
      - "--tlsMode={{ mongodb_mongos_tls_mode }}"
      - "--tlsCertificateKeyFile=/etc/mongo/ssl/mongodb-mongos.pem"
      - "--tlsCAFile=/etc/mongo/ssl/ca.pem"
      - "--tlsClusterFile=/etc/mongo/ssl/mongodb-mongos.pem"
      - "--clusterAuthMode=x509"
      - "--tlsAllowConnectionsWithoutCertificates"
    volumes:
      - {{ mongodb_tls_dir }}/mongodb-mongos.pem:/etc/mongo/ssl/mongodb-mongos.pem:ro,Z
      - {{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
      - {{ mongodb_tls_dir }}/healthcheck.pem:/etc/mongo/ssl/healthcheck.pem:ro,z
    networks:
      - {{ mongodb_network }}
    ports:
      - "{{ mongodb_mongos_node_port }}:27017"
{% if mongodb_exporter_enabled | bool %}
      - "{{ mongodb_exporter_port }}:{{ mongodb_exporter_port }}"
{% endif %}
    ulimits:
      nofile:
        soft: {{ mongodb_ulimit_nofile }}
        hard: {{ mongodb_ulimit_nofile }}
      nproc:
        soft: -1
        hard: -1
    healthcheck:
      test: ["CMD", "mongosh", "--port", "27017", "--quiet", "--tls", "--tlsCertificateKeyFile", "/etc/mongo/ssl/healthcheck.pem", "--tlsCAFile", "/etc/mongo/ssl/ca.pem", "--authenticationMechanism", "MONGODB-X509", "--authenticationDatabase", "$$external", "--eval", "db.adminCommand('ping')"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
    logging:
      driver: "json-file"
      options:
        max-size: "100m"
        max-file: "5"
    deploy:
      resources:
        limits:
          memory: {{ mongodb_mongos_mem_limit_mb }}m
    # Preferred victim: stateless router, cheapest thing here to lose.
    oom_score_adj: {{ mongodb_mongos_oom_score_adj }}
{% endif %}

{% if mongodb_exporter_enabled | bool %}
  mongodb-exporter:
    image: {{ mongodb_exporter_image }}
    container_name: mongodb-exporter
    restart: unless-stopped
    user: "{{ mongodb_uid }}:{{ mongodb_gid }}"
    command:
      - --mongodb.uri=mongodb://localhost:27017/?tls=true&tlsCertificateKeyFile=/etc/mongo/ssl/exporter.pem&tlsCAFile=/etc/mongo/ssl/ca.pem&authMechanism=MONGODB-X509&authSource=$$external
      - --collect-all
      - --compatible-mode
    network_mode: service:{{ 'mongos' if mongodb_cluster_type == 'sharded' else 'mongod' }}
    volumes:
{# Shared (z) label once several exporters mount the same cert: a private (Z)
   label is rewritten by whichever container starts last, locking out the rest. #}
      - {{ mongodb_tls_dir }}/exporter.pem:/etc/mongo/ssl/exporter.pem:ro,{{ 'z' if mongodb_exporter_members | length > 0 else 'Z' }}
      - {{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
    depends_on:
      - {{ 'mongos' if mongodb_cluster_type == 'sharded' else 'mongod' }}
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "3"
    deploy:
      resources:
        limits:
          memory: {{ mongodb_exporter_mem_limit_mb }}m
    oom_score_adj: {{ mongodb_exporter_oom_score_adj }}
{% for _member in mongodb_exporter_members %}

  # Per-member exporter for this node's {{ _member.compose_svc }} — see
  # mongodb_exporter_{{ _member.name }}_enabled. Host network: it reaches
  # {{ _member.compose_svc }} on its published port {{ _member.node_port }} and serves
  # /metrics on the host's :{{ _member.port }}.
  mongodb-exporter-{{ _member.name }}:
    image: {{ mongodb_exporter_image }}
    container_name: mongodb-exporter-{{ _member.name }}
    restart: unless-stopped
    user: "{{ mongodb_uid }}:{{ mongodb_gid }}"
    command:
      - --mongodb.uri=mongodb://localhost:{{ _member.node_port }}/?tls=true&tlsCertificateKeyFile=/etc/mongo/ssl/exporter.pem&tlsCAFile=/etc/mongo/ssl/ca.pem&authMechanism=MONGODB-X509&authSource=$$external
      - --web.listen-address=:{{ _member.port }}
      - --collect-all
      - --compatible-mode
    network_mode: host
    volumes:
      - {{ mongodb_tls_dir }}/exporter.pem:/etc/mongo/ssl/exporter.pem:ro,z
      - {{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
    depends_on:
      - {{ _member.compose_svc }}
    logging:
      driver: "json-file"
      options:
        max-size: "50m"
        max-file: "3"
    deploy:
      resources:
        limits:
          memory: {{ mongodb_exporter_mem_limit_mb }}m
    oom_score_adj: {{ mongodb_exporter_oom_score_adj }}
{% endfor %}
{% endif %}

networks:
  {{ mongodb_network }}:
    external: true
