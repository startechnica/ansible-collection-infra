# Auto-generated by Ansible mongodb role (Quadlet path).
# Per-member exporter for this node's {{ _member.name }} ({{ _member.service }}), rendered
# once per entry of mongodb_exporter_members — see
# mongodb_exporter_{{ _member.name }}_enabled in defaults/main/exporter.yml. Same image,
# client cert, flags, memory cap and OOM bias as mongodb-exporter.container,
# but connected directly to localhost:{{ _member.node_port }} instead of mongos, and
# serving /metrics on :{{ _member.port }}.
[Unit]
Description=MongoDB Prometheus exporter ({{ _member.name }})
Wants=network-online.target {{ _member.service }}.service
After=network-online.target {{ _member.service }}.service
Requires={{ _member.service }}.service

[Container]
ContainerName=mongodb-exporter-{{ _member.name }}
Image={{ mongodb_exporter_image }}
User={{ mongodb_uid }}
Group={{ mongodb_gid }}

Network=host

# `$$external` → literal `$external` after systemd's variable substitution;
# see mongodb-exporter.container.j2.
Exec=--mongodb.uri=mongodb://localhost:{{ _member.node_port }}/?tls=true&tlsCertificateKeyFile=/etc/mongo/ssl/exporter.pem&tlsCAFile=/etc/mongo/ssl/ca.pem&authMechanism=MONGODB-X509&authSource=$$external \
  --web.listen-address=:{{ _member.port }} \
  --collect-all \
  --compatible-mode

# Shared (z) labels: the same files are mounted by every exporter container.
Volume={{ mongodb_tls_dir }}/exporter.pem:/etc/mongo/ssl/exporter.pem:ro,z
Volume={{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z

Memory={{ mongodb_exporter_mem_limit_mb }}m
# First in line for the OOM killer — telemetry, nothing depends on it.
PodmanArgs=--oom-score-adj={{ mongodb_exporter_oom_score_adj }}
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
