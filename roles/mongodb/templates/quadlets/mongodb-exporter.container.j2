# Auto-generated by Ansible mongodb role (Quadlet path).
# With the rest of the stack moved to Network=host (see
# mongodb-mongod.container.j2 for the rationale), the exporter joins
# the host stack too and connects to localhost:<peer_port> directly.
# That replaces the old `Network=container:mongodb-mongos` namespace-
# sharing trick — same effective semantic (exporter scrapes via
# localhost), simpler unit graph.
{% set _peer = 'mongodb-mongos' if mongodb_cluster_type == 'sharded' else 'mongodb-mongod' %}
{% set _peer_port = mongodb_mongos_node_port if mongodb_cluster_type == 'sharded' else mongodb_mongod_node_port %}
[Unit]
Description=MongoDB Prometheus exporter
Wants=network-online.target {{ _peer }}.service
After=network-online.target {{ _peer }}.service
Requires={{ _peer }}.service

[Container]
ContainerName=mongodb-exporter
Image={{ mongodb_exporter_image }}
User={{ mongodb_uid }}
Group={{ mongodb_gid }}

Network=host

# `$$external` → literal `$external` after systemd's variable
# substitution. systemd processes `$VAR` references in Exec= the same
# way it does in ExecStart=, so the bare `$external` we use in the
# mongo X.509 auth source would otherwise be substituted with the
# (undefined) environment variable's value (empty string), leaving
# `authSource=` and breaking authentication. Same escape the
# docker-compose template uses for its `$$external` healthchecks.
Exec=--mongodb.uri=mongodb://localhost:{{ _peer_port }}/?tls=true&tlsCertificateKeyFile=/etc/mongo/ssl/exporter.pem&tlsCAFile=/etc/mongo/ssl/ca.pem&authMechanism=MONGODB-X509&authSource=$$external \
  --web.listen-address=:{{ mongodb_exporter_port }} \
  --collect-all \
  --compatible-mode

Volume={{ mongodb_tls_dir }}/exporter.pem:/etc/mongo/ssl/exporter.pem:ro,Z
Volume={{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z

Memory=128m
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
