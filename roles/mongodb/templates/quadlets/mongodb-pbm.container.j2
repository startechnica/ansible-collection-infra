# Auto-generated by Ansible mongodb role (Quadlet path) — PBM agent.
# Rendered once per data-bearing mongod (parameterized by `_pbm_agent`):
#   - shard agent  → manages local mongod   (replSet {{ mongodb_shard_replset }})
#   - config agent → manages local configsvr (replSet {{ mongodb_config_replset }})
# Network=host like the rest of the stack; the agent connects to its local node
# on the node's host port, authenticating by X.509 client cert
# (CN={{ mongodb_pbm_cn }}). State lives in the cluster + S3, so no data volume.
# NOTE: no directConnection — PBM reuses the URI options when building its
# internal connection to the config replica set (multiple hosts), and
# directConnection there errors "a direct connection cannot be made if multiple
# hosts are specified". Plain localhost seed is Percona's documented form.
#
# systemd Environment= values are literal (no `$` expansion), so the bare
# `$external` auth source is passed through to the container unmodified.
[Unit]
Description=Percona Backup for MongoDB agent ({{ _pbm_agent.role }})
Wants=network-online.target {{ _pbm_agent.svc }}.service
After=network-online.target {{ _pbm_agent.svc }}.service
Requires={{ _pbm_agent.svc }}.service

[Container]
ContainerName={{ _pbm_agent.name }}
Image={{ mongodb_pbm_image }}
User={{ mongodb_uid }}
Group={{ mongodb_gid }}

# Bypass the image's entrypoint wrapper. That script waits for the replica set
# using the legacy `mongo` shell, which doesn't honor the URI's tlsCAFile and so
# fails our self-signed CA with "SSL peer certificate validation failed" — it
# loops forever and never exec's pbm-agent. Run pbm-agent directly; its Go
# driver validates against tlsCAFile and retries the connection on its own.
# `/bin/bash -c 'exec pbm-agent'` replaces both the image ENTRYPOINT and CMD
# (which is `pbm-agent`), so we don't end up running `pbm-agent pbm-agent`.
Entrypoint=/bin/bash
Exec=-c "exec pbm-agent"

Network=host

Environment=PBM_MONGODB_URI=mongodb://localhost:{{ _pbm_agent.port }}/?authMechanism=MONGODB-X509&authSource=$external&tls=true&tlsCertificateKeyFile=/etc/mongo/ssl/pbm-agent.pem&tlsCAFile=/etc/mongo/ssl/ca.pem

Volume={{ mongodb_tls_dir }}/pbm-agent.pem:/etc/mongo/ssl/pbm-agent.pem:ro,Z
Volume={{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
Volume={{ mongodb_root_dir }}/pbm/pbm-config.yaml:/etc/pbm/pbm-config.yaml:ro,z

Memory={{ mongodb_pbm_mem_limit_mb }}m
LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
