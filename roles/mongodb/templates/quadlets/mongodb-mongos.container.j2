# Auto-generated by Ansible mongodb role (Quadlet path).
# Sharded mode only — query router.
# After= ensures configsvr replica set is up before mongos starts; otherwise
# mongos enters a retry loop and the systemd start can time out.
# See mongodb-mongod.container.j2 for why this container uses
# Network=host instead of the podman bridge.
[Unit]
Description=MongoDB query router (mongos)
Wants=network-online.target mongodb-configsvr.service
After=network-online.target mongodb-configsvr.service

[Container]
ContainerName=mongodb-mongos
Image={{ mongodb_image_registry }}/{{ mongodb_image_repository }}:{{ mongodb_image_tag }}
User={{ mongodb_uid }}
Group={{ mongodb_gid }}

Network=host

Exec=mongos \
{% if mongodb_bootstrap | default(false) | bool %}
  --transitionToAuth \
{% endif %}
  --configdb {{ mongodb_config_replset }}/{{ mongodb_nodes | map(attribute='ipv4') | map('regex_replace', '^(.*)$', '\\1:' ~ mongodb_configsvr_node_port) | join(',') }} \
  --port={{ mongodb_mongos_node_port }} \
  --bind_ip_all \
  --tlsMode={{ mongos_tls_mode }} \
  --tlsCertificateKeyFile=/etc/mongo/ssl/mongodb-mongos.pem \
  --tlsCAFile=/etc/mongo/ssl/ca.pem \
  --tlsClusterFile=/etc/mongo/ssl/mongodb-mongos.pem \
  --clusterAuthMode=x509 \
  --tlsAllowConnectionsWithoutCertificates

Volume={{ mongodb_tls_dir }}/mongodb-mongos.pem:/etc/mongo/ssl/mongodb-mongos.pem:ro,Z
Volume={{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
Volume={{ mongodb_tls_dir }}/healthcheck.pem:/etc/mongo/ssl/healthcheck.pem:ro,z

PodmanArgs=--ulimit nofile={{ mongodb_ulimit_nofile }}:{{ mongodb_ulimit_nofile }} \
          --ulimit nproc=-1:-1

Memory={{ mongos_mem_limit_mb }}m

HealthCmd=mongosh --port {{ mongodb_mongos_node_port }} --quiet --tls --tlsCertificateKeyFile /etc/mongo/ssl/healthcheck.pem --tlsCAFile /etc/mongo/ssl/ca.pem --authenticationMechanism MONGODB-X509 --authenticationDatabase '$external' --eval 'db.adminCommand("ping")'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
