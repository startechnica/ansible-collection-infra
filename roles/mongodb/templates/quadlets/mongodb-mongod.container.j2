# Auto-generated by Ansible mongodb role (Quadlet path).
# Quadlet → systemd unit name: mongodb-mongod.service
# Manage with: systemctl {start,stop,restart,status} mongodb-mongod.service
#
# `Network=host` instead of a bridge: mongo replica sets identify peers
# by host:port, and the calling node must see at least one of those
# entries as itself. On a podman bridge each container's only IPs are
# 10.89.0.x (per-host bridge, not routed between hosts), so members
# listed as 10.147.8.x:27019 — the actual host IPs Ansible knows about
# — never match the container's view of itself, and rs.initiate fails
# with "no host described in new configuration maps to this node".
# Host networking eliminates the gap: mongod binds directly on the
# host's stack and is reachable at host_ip:mongodb_mongod_node_port from
# every other node.
[Unit]
Description=MongoDB shard (mongod)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mongodb-mongod
Image={{ mongodb_image_registry }}/{{ mongodb_image_repository }}:{{ mongodb_image_tag }}
User={{ mongodb_uid }}
Group={{ mongodb_gid }}

# Host networking: mongod binds directly on host:mongodb_mongod_node_port,
# no NAT, no PublishPort. mongos/configsvr do the same on their own
# distinct ports, so there's no host-side collision.
Network=host

# `mongod` is the entrypoint in the official image; Exec= passes args.
Exec=mongod \
  {{ '--transitionToAuth' if mongodb_bootstrap | default(false) | bool else '--auth' }} \
{% if mongodb_cluster_type == 'sharded' %}
  --shardsvr \
{% endif %}
  --port={{ mongodb_mongod_node_port }} \
  --replSet={{ mongodb_shard_replset }} \
  --wiredTigerCacheSizeGB={{ (mongod_mem_limit_mb * 0.5 / 1024) | float | round(2) }} \
  --bind_ip_all \
  --quiet \
  --tlsMode={{ mongod_tls_mode }} \
  --tlsCertificateKeyFile=/etc/mongo/ssl/mongodb-mongod.pem \
  --tlsCAFile=/etc/mongo/ssl/ca.pem \
  --tlsClusterFile=/etc/mongo/ssl/mongodb-mongod.pem \
  --clusterAuthMode=x509 \
  --tlsAllowConnectionsWithoutCertificates

Volume={{ mongodb_mongod_data_dir }}:/data/db:Z
Volume={{ mongodb_tls_dir }}/mongodb-mongod.pem:/etc/mongo/ssl/mongodb-mongod.pem:ro,Z
Volume={{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
Volume={{ mongodb_tls_dir }}/healthcheck.pem:/etc/mongo/ssl/healthcheck.pem:ro,z

# Quadlet doesn't have a direct `ulimits` mapping — pass through to podman run.
PodmanArgs=--ulimit nofile={{ mongodb_ulimit_nofile }}:{{ mongodb_ulimit_nofile }} \
          --ulimit nproc=-1:-1

# Resource limits
Memory={{ mongod_mem_limit_mb }}m

# Healthcheck (mirrors docker-compose definition).
HealthCmd=mongosh --port {{ mongodb_mongod_node_port }} --quiet --tls --tlsCertificateKeyFile /etc/mongo/ssl/healthcheck.pem --tlsCAFile /etc/mongo/ssl/ca.pem --authenticationMechanism MONGODB-X509 --authenticationDatabase '$external' --eval 'db.adminCommand("ping")'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
