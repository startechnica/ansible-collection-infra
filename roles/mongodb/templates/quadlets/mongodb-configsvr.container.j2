# Auto-generated by Ansible mongodb role (Quadlet path).
# Sharded mode only — config server.
# See mongodb-mongod.container.j2 for why this container uses
# Network=host instead of the podman bridge.
[Unit]
Description=MongoDB config server (configsvr)
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mongodb-configsvr
Image={{ mongodb_image_registry }}/{{ mongodb_image_repository }}:{{ mongodb_image_tag }}
User={{ mongodb_uid }}
Group={{ mongodb_gid }}

Network=host

Exec=mongod \
  {{ '--transitionToAuth' if mongodb_bootstrap | default(false) | bool else '--auth' }} \
  --configsvr \
  --port={{ mongodb_configsvr_node_port }} \
  --replSet={{ mongodb_config_replset }} \
  --wiredTigerCacheSizeGB={{ (configsvr_mem_limit_mb * 0.5 / 1024) | float | round(2) }} \
  --bind_ip_all \
  --quiet \
  --tlsMode={{ configsvr_tls_mode }} \
  --tlsCertificateKeyFile=/etc/mongo/ssl/mongodb-configsvr.pem \
  --tlsCAFile=/etc/mongo/ssl/ca.pem \
  --tlsClusterFile=/etc/mongo/ssl/mongodb-configsvr.pem \
  --clusterAuthMode=x509 \
  --tlsAllowConnectionsWithoutCertificates

Volume={{ mongodb_configsvr_data_dir }}:/data/configdb:Z
Volume={{ mongodb_tls_dir }}/mongodb-configsvr.pem:/etc/mongo/ssl/mongodb-configsvr.pem:ro,Z
Volume={{ mongodb_tls_dir }}/ca.pem:/etc/mongo/ssl/ca.pem:ro,z
Volume={{ mongodb_tls_dir }}/healthcheck.pem:/etc/mongo/ssl/healthcheck.pem:ro,z

PodmanArgs=--ulimit nofile={{ mongodb_ulimit_nofile }}:{{ mongodb_ulimit_nofile }} \
          --ulimit nproc=-1:-1

Memory={{ configsvr_mem_limit_mb }}m

HealthCmd=mongosh --port {{ mongodb_configsvr_node_port }} --quiet --tls --tlsCertificateKeyFile /etc/mongo/ssl/healthcheck.pem --tlsCAFile /etc/mongo/ssl/ca.pem --authenticationMechanism MONGODB-X509 --authenticationDatabase '$external' --eval 'db.adminCommand("ping")'
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s

LogDriver=journald

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target default.target
