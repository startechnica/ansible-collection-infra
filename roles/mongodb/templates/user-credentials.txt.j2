# ═══════════════════════════════════════════════════════════════
# MongoDB Credentials — {{ _db.name }}
# ═══════════════════════════════════════════════════════════════

Database: {{ _db.name }}
Username: {{ _user.name }}
Password: {{ _user.password }}
Auth DB:  {{ _user.auth_db | default(_db.name) }}
Roles:    {{ _user.roles | map(attribute='role') | join(', ') }}

# Connection URI (with TLS)
mongodb://{{ _user.name }}:{{ _user.password | urlencode }}@{{ _mongos_hosts }}/{{ _db.name }}?authSource={{ _user.auth_db | default(_db.name) }}&tls=true&tlsAllowInvalidCertificates=true

# Connection URI (without TLS)
mongodb://{{ _user.name }}:{{ _user.password | urlencode }}@{{ _mongos_hosts }}/{{ _db.name }}?authSource={{ _user.auth_db | default(_db.name) }}

# mongosh
mongosh --quiet "mongodb://{{ _user.name }}:{{ _user.password | urlencode }}@{{ _mongos_hosts }}/{{ _db.name }}?authSource={{ _user.auth_db | default(_db.name) }}"
