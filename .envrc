# direnv config for the ansible workspace.
# Auto-applied when you `cd infra/` (and `direnv allow` is granted).
# Install direnv: https://direnv.net/  •  Hook into your shell: ~/.bashrc

# 1. Activate the project venv if it exists. Avoids polluting the system
#    Python with ansible/community.* modules and lets you run ansible-* tools
#    without `source .venv/bin/activate` every shell.
if [ -d .venv ]; then
  source .venv/bin/activate
fi

# 2. Pin Ansible config + collections path to this directory tree, so
#    `ansible-playbook` from anywhere inside infra/ behaves the same.
export ANSIBLE_CONFIG="$PWD/ansible.cfg"
export ANSIBLE_COLLECTIONS_PATH="$PWD/collections:$HOME/.ansible/collections"

# 3. Reduce log noise on slow plays — show task progression but skip module
#    deprecation walls.
export ANSIBLE_DEPRECATION_WARNINGS=false
export ANSIBLE_COMMAND_WARNINGS=false

# 4. Convenience: shorter prompts when working in this dir.
#    `ANSIBLE_INV` is read by the Makefile if INV= isn't passed; un-comment
#    after you've picked a default inventory for day-to-day work.
# export ANSIBLE_INV=manu

# 5. Suppress the host-key prompt for fresh VMs the first time. Keep it
#    OFF in production environments — only useful during initial provision
#    cycles where every test run hits new VMs.
export ANSIBLE_HOST_KEY_CHECKING=false
